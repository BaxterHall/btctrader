{
  "name": "btctrader",
  "version": "1.0.0",
  "description": "USD to BTC trader App",
  "main": "index.js",
  "babel": {
    "presets": [
      "@babel/preset-env",
      "@babel/preset-react"
    ],
    "plugins": [
      "@babel/plugin-transform-class-properties",
      "@babel/plugin-transform-regenerator",
      "@babel/plugin-transform-object-rest-spread"
    ]
  },
  "scripts": {
    "server": "node ./src/server/index.js",
    "dev": "webpack serve --config ./webpack-config.js --open",
    "start": "npm run server | npm run dev",
    "build": "webpack --config ./webpack-config.js"
  },
  "author": "Baxter Hall",
  "license": "ISC",
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-class-properties": "^7.25.0",
    "@babel/plugin-transform-object-rest-spread": "^7.25.0",
    "@babel/plugin-transform-regenerator": "^7.25.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "babel-loader": "^10.1.0",
    "css-loader": "^7.1.4",
    "eslint": "^9.7.0",
    "eslint-plugin-react": "^7.37.0",
    "nodemon": "^3.1.14",
    "sass": "^1.97.3",
    "sass-loader": "^16.0.7",
    "style-loader": "^4.0.0",
    "url-loader": "^4.1.1",
    "webpack": "^5.105.4",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0"
  }
}
